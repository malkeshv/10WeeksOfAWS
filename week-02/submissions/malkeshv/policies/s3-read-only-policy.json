{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListOnlyTheDemoBucket",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::aws-iam-role-demo-malkesh-2026"
    },
    {
      "Sid": "ReadObjectsFromTheDemoBucket",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::aws-iam-role-demo-malkesh-2026/*"
    }
  ]
}
